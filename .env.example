# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY=""

# APP_URL: Current service URL
APP_URL=""

# MONGODB_URI: Connection string for MongoDB Atlas cluster
# Keep this secret; never commit your real credentials to public git.
MONGODB_URI="mongodb+srv://<username>:<password>@jnjtestcluster.695tiet.mongodb.net/jnj_innovations?retryWrites=true&w=majority"

# Server Port (Cloud Run automatically provides PORT, default is 3000)
PORT=3000

# CORS Origins: Comma-separated list of allowed frontend origins for your backend
CORS_ORIGINS="https://jnjinnovations.com,https://www.jnjinnovations.com"

# VITE_API_URL: Target URL of your deployed backend API for static frontend builds
# Example: https://jnj-backend-xxxx.us-east1.run.app (Leave empty if running full-stack container)
VITE_API_URL=""

# Contact form keys (Optional)
VITE_WEB3FORMS_KEY=""
VITE_FORMSPREE_ID=""
